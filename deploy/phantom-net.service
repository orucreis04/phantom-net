[Unit]
Description=Phantom-Net Defensive Deception Platform
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=phantom
Group=phantom
WorkingDirectory=/opt/phantom-net
EnvironmentFile=-/etc/phantom-net/phantom-net.env
ExecStartPre=/usr/bin/python3 /opt/phantom-net/main.py --config /etc/phantom-net/config.yaml --check-config --strict-config
ExecStart=/usr/bin/python3 /opt/phantom-net/main.py --config /etc/phantom-net/config.yaml --host 0.0.0.0
Restart=on-failure
RestartSec=5
TimeoutStopSec=20
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ReadWritePaths=/opt/phantom-net/data

[Install]
WantedBy=multi-user.target
